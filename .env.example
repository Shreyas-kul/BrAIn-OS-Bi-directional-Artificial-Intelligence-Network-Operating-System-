# ============================================================
# BrAIn OS — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- ChromaDB ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIR=./data/chromadb

# --- LLM Backends ---
# Primary: Ollama (local, free, private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Fallback: Groq (cloud, ultra-fast)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# Default backend: "ollama" or "groq"
LLM_DEFAULT_BACKEND=ollama

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Scheduler ---
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT_SECONDS=120
PRIORITY_AGING_SECONDS=30

# --- Memory ---
L1_CACHE_TTL_SECONDS=300
L1_CACHE_MAX_ITEMS=100
L2_SESSION_TTL_SECONDS=3600

# --- Security ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Observability ---
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=brain-os
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=["http://localhost:3000"]
